{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://aerospike.com/conformance/schema/fixture.schema.json",
	"title": "Conformance fixture file",
	"type": "object",
	"additionalProperties": false,
	"required": ["kind", "rows"],
	"properties": {
		"kind": { "enum": ["translate", "merge", "tls", "dns", "aws-tags"] },
		"description": { "type": "string" },
		"shapes": {
			"type": "object",
			"minProperties": 1,
			"propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
			"additionalProperties": { "$ref": "#/$defs/shape" }
		},
		"rows": { "type": "array", "minItems": 1 }
	},
	"allOf": [
		{
			"if": { "properties": { "kind": { "const": "translate" } } },
			"then": {
				"properties": {
					"rows": { "items": { "$ref": "#/$defs/translateRow" } }
				}
			}
		},
		{
			"if": { "properties": { "kind": { "const": "merge" } } },
			"then": {
				"properties": { "rows": { "items": { "$ref": "#/$defs/mergeRow" } } }
			}
		},
		{
			"if": { "properties": { "kind": { "const": "tls" } } },
			"then": {
				"required": ["shapes"],
				"properties": { "rows": { "items": { "$ref": "#/$defs/tlsRow" } } }
			},
			"else": { "not": { "required": ["shapes"] } }
		},
		{
			"if": {
				"properties": {
					"kind": {
						"const": "dns"
					}
				}
			},
			"then": {
				"properties": {
					"rows": {
						"items": {
							"$ref": "#/$defs/dnsRow"
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"kind": {
						"const": "aws-tags"
					}
				}
			},
			"then": {
				"properties": {
					"rows": {
						"items": {
							"$ref": "#/$defs/awsTagsRow"
						}
					}
				}
			}
		}
	],
	"$defs": {
		"row": {
			"type": "object",
			"required": ["case", "because", "input"],
			"properties": {
				"case": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
				"because": { "type": "string", "minLength": 1 },
				"state": { "const": "blocked" },
				"blockedBy": { "type": "string", "minLength": 1 }
			},
			"if": { "required": ["state"] },
			"then": { "required": ["blockedBy"], "not": { "required": ["expect"] } },
			"else": { "required": ["expect"], "not": { "required": ["blockedBy"] } }
		},
		"port": { "type": "integer", "minimum": 0, "maximum": 65535 },
		"shape": {
			"type": "object",
			"additionalProperties": false,
			"required": ["subjectCN", "san"],
			"properties": {
				"subjectCN": { "type": "string" },
				"san": {
					"type": "array",
					"items": { "type": "string", "pattern": "^(DNS|IP):.+$" }
				}
			}
		},
		"hostMap": {
			"type": "object",
			"additionalProperties": { "type": "string" }
		},
		"seed": {
			"type": "object",
			"additionalProperties": false,
			"required": ["host", "port"],
			"properties": {
				"host": { "type": "string" },
				"port": { "$ref": "#/$defs/port" }
			}
		},
		"seedList": { "type": "array", "items": { "$ref": "#/$defs/seed" } },
		"missFacts": {
			"type": "object",
			"additionalProperties": false,
			"required": ["category", "messageContains"],
			"properties": {
				"category": { "const": "translation-miss" },
				"messageContains": {
					"type": "object",
					"additionalProperties": false,
					"required": ["nodeName", "host", "port", "translator"],
					"properties": {
						"nodeName": { "type": "string" },
						"host": { "type": "string" },
						"port": { "$ref": "#/$defs/port" },
						"translator": { "enum": ["static-map", "port-map"] }
					}
				}
			}
		},
		"hostPort": {
			"type": "string",
			"pattern": "^(\\[[0-9A-Fa-f:.]+\\]|[^\\[\\]:]+):[0-9]+$"
		},
		"translateRow": {
			"$ref": "#/$defs/row",
			"unevaluatedProperties": false,
			"properties": {
				"config": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"ip_map": { "$ref": "#/$defs/hostMap" },
						"translation": {
							"type": "object",
							"additionalProperties": false,
							"required": ["provider"],
							"properties": {
								"provider": {
									"enum": ["static-map", "port-map", "pass-through"]
								},
								"on_miss": { "enum": ["pass_through", "strict"] },
								"static_map": { "$ref": "#/$defs/hostMap" },
								"port_map": {
									"type": "object",
									"propertyNames": {
										"pattern": "^(\\[[0-9A-Fa-f:.]+\\]:[0-9]+|[^\\[\\]:]+:[0-9]+|[0-9A-Fa-f]+)$"
									},
									"additionalProperties": { "$ref": "#/$defs/hostPort" }
								}
							},
							"allOf": [
								{
									"if": {
										"properties": { "provider": { "const": "static-map" } }
									},
									"then": {
										"required": ["static_map"],
										"not": { "required": ["port_map"] }
									}
								},
								{
									"if": {
										"properties": { "provider": { "const": "port-map" } }
									},
									"then": {
										"required": ["port_map"],
										"not": { "required": ["static_map"] }
									}
								},
								{
									"if": {
										"properties": { "provider": { "const": "pass-through" } }
									},
									"then": {
										"not": {
											"anyOf": [
												{ "required": ["static_map"] },
												{ "required": ["port_map"] }
											]
										}
									}
								}
							]
						}
					},
					"not": { "required": ["ip_map", "translation"] }
				},
				"input": {
					"type": "object",
					"additionalProperties": false,
					"required": ["nodeName", "tlsName", "host", "port", "sourceList"],
					"properties": {
						"nodeName": { "type": "string" },
						"tlsName": { "type": ["string", "null"] },
						"host": { "type": "string" },
						"port": { "$ref": "#/$defs/port" },
						"sourceList": { "enum": ["standard", "alternate"] }
					}
				},
				"expect": {
					"type": "object",
					"additionalProperties": false,
					"oneOf": [
						{
							"required": ["host", "port", "tlsName"],
							"not": { "required": ["error"] }
						},
						{
							"required": ["error"],
							"not": {
								"anyOf": [
									{ "required": ["host"] },
									{ "required": ["port"] },
									{ "required": ["tlsName"] }
								]
							}
						}
					],
					"properties": {
						"host": { "type": "string" },
						"port": { "$ref": "#/$defs/port" },
						"tlsName": { "type": ["string", "null"] },
						"error": { "$ref": "#/$defs/missFacts" }
					}
				}
			},
			"required": ["config"]
		},
		"mergeRow": {
			"$ref": "#/$defs/row",
			"unevaluatedProperties": false,
			"required": ["config"],
			"properties": {
				"config": {
					"type": "object",
					"additionalProperties": false,
					"required": ["seeds"],
					"properties": {
						"seeds": { "$ref": "#/$defs/seedList" },
						"discovery": {
							"type": "object",
							"additionalProperties": false,
							"properties": {
								"merge_policy": {
									"enum": ["merge", "replace", "discovery_only"]
								}
							}
						}
					}
				},
				"input": {
					"type": "object",
					"additionalProperties": false,
					"required": ["discoveryResults"],
					"properties": {
						"discoveryResults": {
							"type": "array",
							"minItems": 1,
							"items": { "$ref": "#/$defs/seedList" }
						}
					}
				},
				"expect": {
					"type": "object",
					"additionalProperties": false,
					"required": ["snapshots"],
					"properties": {
						"snapshots": {
							"type": "array",
							"minItems": 1,
							"items": { "$ref": "#/$defs/seedList" }
						}
					}
				}
			}
		},
		"tlsRow": {
			"$ref": "#/$defs/row",
			"unevaluatedProperties": false,
			"properties": {
				"config": false,
				"input": {
					"type": "object",
					"additionalProperties": false,
					"required": ["tlsName", "shape"],
					"properties": {
						"tlsName": { "type": "string" },
						"shape": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
					}
				},
				"expect": {
					"type": "object",
					"additionalProperties": false,
					"required": ["outcome"],
					"properties": { "outcome": { "enum": ["accept", "reject"] } }
				}
			}
		},
		"host": {
			"type": "object",
			"additionalProperties": false,
			"required": ["host", "port"],
			"properties": {
				"host": {
					"type": "string"
				},
				"port": {
					"$ref": "#/$defs/port"
				},
				"tlsName": {
					"type": "string"
				}
			}
		},
		"hostList": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/host"
			}
		},
		"providerError": {
			"type": "object",
			"additionalProperties": false,
			"required": ["category", "messageContains"],
			"properties": {
				"category": {
					"enum": ["discovery-failed", "aws-error", "timeout"]
				},
				"messageContains": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			}
		},
		"providerExpect": {
			"type": "object",
			"additionalProperties": false,
			"required": ["refreshes"],
			"properties": {
				"refreshes": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["seeds"],
						"properties": {
							"hosts": {
								"$ref": "#/$defs/hostList"
							},
							"error": {
								"$ref": "#/$defs/providerError"
							},
							"seeds": {
								"$ref": "#/$defs/hostList"
							}
						},
						"oneOf": [
							{
								"required": ["hosts"]
							},
							{
								"required": ["error"]
							}
						]
					}
				}
			}
		},
		"dnsRecord": {
			"type": "object",
			"required": ["name", "type"],
			"properties": {
				"name": {
					"type": "string",
					"minLength": 1
				},
				"type": {
					"enum": ["A", "AAAA", "SRV"]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"type": {
								"const": "A"
							}
						}
					},
					"then": {
						"additionalProperties": false,
						"required": ["address"],
						"properties": {
							"name": true,
							"type": true,
							"address": {
								"type": "string",
								"format": "ipv4"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "AAAA"
							}
						}
					},
					"then": {
						"additionalProperties": false,
						"required": ["address"],
						"properties": {
							"name": true,
							"type": true,
							"address": {
								"type": "string",
								"format": "ipv6"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"type": {
								"const": "SRV"
							}
						}
					},
					"then": {
						"additionalProperties": false,
						"required": ["priority", "weight", "port", "target"],
						"properties": {
							"name": true,
							"type": true,
							"priority": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							},
							"weight": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							},
							"port": {
								"$ref": "#/$defs/port"
							},
							"target": {
								"type": "string",
								"minLength": 1
							}
						}
					}
				}
			]
		},
		"dnsRow": {
			"$ref": "#/$defs/row",
			"unevaluatedProperties": false,
			"required": ["config"],
			"properties": {
				"config": {
					"type": "object",
					"additionalProperties": false,
					"required": ["discovery"],
					"properties": {
						"discovery": {
							"type": "object",
							"additionalProperties": false,
							"required": ["provider", "dns"],
							"properties": {
								"provider": {
									"const": "dns"
								},
								"dns": {
									"type": "object",
									"additionalProperties": false,
									"required": ["names"],
									"properties": {
										"names": {
											"type": "array",
											"minItems": 1,
											"items": {
												"type": "string",
												"minLength": 1
											}
										},
										"record_type": {
											"enum": ["a", "srv"]
										},
										"port": {
											"$ref": "#/$defs/port"
										},
										"tls_name": {
											"type": "string"
										},
										"timeout_ms": {
											"type": "integer",
											"minimum": 1
										}
									}
								}
							}
						}
					}
				},
				"input": {
					"type": "object",
					"additionalProperties": false,
					"required": ["refreshes"],
					"properties": {
						"refreshes": {
							"type": "array",
							"minItems": 1,
							"items": {
								"oneOf": [
									{
										"type": "object",
										"additionalProperties": false,
										"required": ["records"],
										"properties": {
											"records": {
												"type": "array",
												"items": {
													"$ref": "#/$defs/dnsRecord"
												}
											}
										}
									},
									{
										"type": "object",
										"additionalProperties": false,
										"required": ["rcode"],
										"properties": {
											"rcode": {
												"const": "SERVFAIL"
											}
										}
									},
									{
										"type": "object",
										"additionalProperties": false,
										"required": ["unanswered"],
										"properties": {
											"unanswered": {
												"const": true
											}
										}
									}
								]
							}
						}
					}
				},
				"expect": {
					"$ref": "#/$defs/providerExpect"
				}
			}
		},
		"ec2Instance": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "state"],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^i-[0-9a-f]+$"
				},
				"state": {
					"enum": [
						"pending",
						"running",
						"shutting-down",
						"terminated",
						"stopping",
						"stopped"
					]
				},
				"private_ip": {
					"type": "string"
				},
				"public_ip": {
					"type": "string"
				},
				"private_dns": {
					"type": "string"
				},
				"public_dns": {
					"type": "string"
				},
				"tags": {
					"type": "object",
					"additionalProperties": {
						"type": "string"
					}
				}
			}
		},
		"awsTagsRow": {
			"$ref": "#/$defs/row",
			"unevaluatedProperties": false,
			"required": ["config"],
			"properties": {
				"config": {
					"type": "object",
					"additionalProperties": false,
					"required": ["discovery"],
					"properties": {
						"discovery": {
							"type": "object",
							"additionalProperties": false,
							"required": ["provider", "aws"],
							"properties": {
								"provider": {
									"const": "aws-tags"
								},
								"aws": {
									"type": "object",
									"additionalProperties": false,
									"required": ["region", "filters"],
									"properties": {
										"region": {
											"type": "string",
											"pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]+$"
										},
										"filters": {
											"type": "array",
											"minItems": 1,
											"items": {
												"type": "object",
												"additionalProperties": false,
												"required": ["name", "values"],
												"properties": {
													"name": {
														"type": "string",
														"minLength": 1,
														"not": {
															"const": "instance-state-name"
														}
													},
													"values": {
														"type": "array",
														"minItems": 1,
														"items": {
															"type": "string"
														}
													}
												}
											}
										},
										"address_field": {
											"enum": [
												"private_ip",
												"public_ip",
												"private_dns",
												"public_dns"
											]
										},
										"port": {
											"$ref": "#/$defs/port"
										},
										"tls_name": {
											"type": "string"
										},
										"timeout_ms": {
											"type": "integer",
											"minimum": 1
										},
										"init_timeout_ms": {
											"type": "integer",
											"minimum": 1
										}
									}
								}
							}
						}
					}
				},
				"input": {
					"type": "object",
					"additionalProperties": false,
					"required": ["refreshes"],
					"properties": {
						"refreshes": {
							"type": "array",
							"minItems": 1,
							"items": {
								"oneOf": [
									{
										"type": "object",
										"additionalProperties": false,
										"required": ["instances"],
										"properties": {
											"instances": {
												"type": "array",
												"items": {
													"$ref": "#/$defs/ec2Instance"
												}
											},
											"page_size": {
												"type": "integer",
												"minimum": 1
											}
										}
									},
									{
										"type": "object",
										"additionalProperties": false,
										"required": ["error"],
										"properties": {
											"error": {
												"type": "object",
												"additionalProperties": false,
												"required": ["status", "code", "message", "request_id"],
												"properties": {
													"status": {
														"type": "integer",
														"minimum": 400,
														"maximum": 599
													},
													"code": {
														"type": "string",
														"minLength": 1
													},
													"message": {
														"type": "string",
														"minLength": 1
													},
													"request_id": {
														"type": "string",
														"minLength": 1
													}
												}
											}
										}
									},
									{
										"type": "object",
										"additionalProperties": false,
										"required": ["unanswered"],
										"properties": {
											"unanswered": {
												"const": true
											}
										}
									}
								]
							}
						}
					}
				},
				"expect": {
					"$ref": "#/$defs/providerExpect"
				}
			}
		}
	}
}
